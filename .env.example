# Copy this file to .env and fill in your values

# Database Configuration
# Local MongoDB: mongodb://localhost:27017/diagnostic-center
# MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/diagnostic-center?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/diagnostic-center

# JWT Secret (REQUIRED - generate a secure random key)
JWT_SECRET=your-secure-random-secret-key

# Server Configuration
PORT=5001

# Google Drive API Configuration (Optional)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GOOGLE_DRIVE_FOLDER_ID=

# Email Configuration (Optional)
EMAIL_USER=
EMAIL_PASS=
